# Copy this file to .env and fill in your actual API keys
# .env is gitignored and will not be committed

# OpenAI API Key (for gpt-4o, gpt-4o-mini, etc.)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for claude-3-5-haiku, claude-3-5-sonnet, etc.)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter API Key (for Gemini models via OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Google Gemini API key (for gemini_direct provider)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional gateway (rcgenai provider): obtain its API base URL from your administrator.
RCGENAI_API_KEY=
RCGENAI_BASE_URL=

# Weights & Biases (optional, for experiment logging)
WANDB_API_KEY=your-wandb-api-key-here
